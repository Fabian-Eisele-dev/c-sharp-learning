using System;

public class Kata
{
    public static string FindNeedle(object[] haystack)
    {
      for(int i=0;i<haystack.Length;i++)
            {
        if (haystack[i] != null && haystack[i].Equals("needle")) // .Equal instead of == & != null to rule out nulls
            return "found the needle at position " + i;
    }
     return "";
    }

}
